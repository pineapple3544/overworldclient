{
  "name": "overworld-launcher",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "overrides": {
    "@electron/get": "5.1.0"
  },
  "description": "Overworld 학교 Minecraft 런처",
  "author": "Overworld",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "preview": "vite --host 127.0.0.1",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:electron": "npm run build && node tests/electron-smoke.mjs",
    "package:win": "npm run build && electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "kr.flyjung.overworld.launcher",
    "productName": "Overworld Launcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "dist-electron/auto-play.ps1",
      "dist-electron/auto-play-accessible.cs"
    ],
    "extraResources": [
      {
        "from": "config/launcher.json",
        "to": "launcher.json"
      },
      {
        "from": "config/modpack.json",
        "to": "modpack.json"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "lucide-react": "1.51.0",
    "prismarine-nbt": "2.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
